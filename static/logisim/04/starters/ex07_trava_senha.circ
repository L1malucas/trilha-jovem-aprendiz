<lib desc="#Wiring" name="0"/>
<lib desc="#Gates" name="1"/>
<lib desc="#Plexers" name="2"/>
<lib desc="#Arithmetic" name="3"/>
<lib desc="#Memory" name="4"/>
<lib desc="#I/O" name="5"/>
<lib desc="#Base" name="6"/>
<main name="main"/>
<options>
  <a name="gateUndefined" val="ignore"/>
  <a name="simlimit" val="1000"/>
  <a name="simrand" val="0"/>
</options>
<circuit name="main">
  <a name="circuit" val="main"/>
  <comp lib="6" loc="(220,20)" name="Text">
    <a name="text" val="Ex 7: trava com senha 8-1-5-3. DIGITO (4 bits) a cada pulso de CLK; ABRE=1 so se a sequencia estiver certa"/>
  </comp>
  <comp lib="0" loc="(60,70)" name="Pin">
    <a name="label" val="DIGITO"/>
    <a name="width" val="4"/>
  </comp>
  <comp lib="0" loc="(60,110)" name="Pin">
    <a name="label" val="CLK"/>
  </comp>
  <comp lib="0" loc="(60,150)" name="Pin">
    <a name="label" val="RESET"/>
  </comp>
  <comp lib="0" loc="(360,70)" name="Pin">
    <a name="label" val="ABRE"/>
    <a name="facing" val="west"/>
    <a name="output" val="true"/>
  </comp>
</circuit>
