<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.2" version="1.0">
This file is intended to be loaded by Logisim (http://www.cburch.com/logisim/).
<lib desc="#Wiring" name="0"/>
<lib desc="#Gates" name="1"/>
<lib desc="#Plexers" name="2"/>
<lib desc="#Arithmetic" name="3"/>
<lib desc="#Memory" name="4"/>
<lib desc="#I/O" name="5"/>
<lib desc="#Base" name="6"/>
<main name="main"/>
<options>
  <a name="gateUndefined" val="ignore"/>
  <a name="simlimit" val="1000"/>
  <a name="simrand" val="0"/>
</options>
<circuit name="main">
  <a name="circuit" val="main"/>
  <comp lib="6" loc="(180,20)" name="Text">
    <a name="text" val="Meio somador: SOMA = A XOR B, CARRY = A AND B"/>
  </comp>
  <comp lib="0" loc="(30,50)" name="Pin">
    <a name="label" val="A"/>
  </comp>
  <comp lib="0" loc="(30,70)" name="Pin">
    <a name="label" val="B"/>
  </comp>
  <comp lib="1" loc="(150,60)" name="XOR Gate">
    <a name="size" val="30"/>
  </comp>
  <comp lib="1" loc="(150,140)" name="AND Gate">
    <a name="size" val="30"/>
  </comp>
  <wire from="(30,50)" to="(50,50)"/>
  <wire from="(50,50)" to="(50,130)"/>
  <wire from="(50,50)" to="(120,50)"/>
  <wire from="(50,130)" to="(120,130)"/>
  <wire from="(30,70)" to="(60,70)"/>
  <wire from="(60,70)" to="(60,150)"/>
  <wire from="(60,70)" to="(120,70)"/>
  <wire from="(60,150)" to="(120,150)"/>
  <wire from="(150,60)" to="(220,60)"/>
  <comp lib="0" loc="(220,60)" name="Pin">
    <a name="label" val="SOMA"/>
    <a name="facing" val="west"/>
    <a name="output" val="true"/>
  </comp>
  <wire from="(150,140)" to="(220,140)"/>
  <comp lib="0" loc="(220,140)" name="Pin">
    <a name="label" val="CARRY"/>
    <a name="facing" val="west"/>
    <a name="output" val="true"/>
  </comp>
</circuit>
</project>
